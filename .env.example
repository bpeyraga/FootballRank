# Copiá este archivo a .env.local (está en .gitignore) y completá los valores.
# Las variables con prefijo VITE_ se meten en el build y son PÚBLICAS: nunca pongas secretos con ese prefijo.

# ---------- Supabase (EN USO)
# URL del proyecto: Supabase → Project Settings → API. Sin /rest/v1 al final.
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Clave anon/publishable (misma pantalla). Es pública por diseño: la seguridad la dan las políticas RLS.
# Nunca la service_role ni la contraseña de la base. En Vercel cambiarla requiere redeploy.
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Solo local (EN USO, opcional)
# Personal access token para correr migraciones desde la terminal (Supabase Management API).
# Se genera en https://supabase.com/dashboard/account/tokens. Sin VITE_: nunca llega al navegador.
# NO cargarlo en Vercel. Da acceso a toda tu cuenta: revocalo si se filtra.
SUPABASE_ACCESS_TOKEN=sbp_...

# ---------- DEPRECADAS (no hacen falta)
# KV_REST_API_READ_ONLY_TOKEN, KV_REST_API_TOKEN, KV_REST_API_URL, KV_URL, REDIS_URL:
#   eran de la app vieja con Upstash Redis (eliminada). Ningún código las usa.
# VERCEL_OIDC_TOKEN: la agrega `vercel env pull` sola; la app no la usa.
